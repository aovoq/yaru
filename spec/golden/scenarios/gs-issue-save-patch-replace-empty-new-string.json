{
  "name": "gs-issue-save-patch-replace-empty-new-string",
  "description": "patch の replace は new_string が空でも、一致した部分を消せることを確かめる",
  "steps": [
    {
      "arguments": ["init"],
      "now": "2026-09-28T12:00:00.000Z"
    },
    {
      "arguments": ["issue", "save", "--title", "x", "--body", "alpha beta gamma"],
      "now": "2026-09-28T12:00:00.000Z"
    },
    {
      "arguments": [
        "issue",
        "save",
        "--id",
        "1",
        "--patch",
        "[{\"op\":\"replace\",\"old_string\":\"beta\",\"new_string\":\"\"}]"
      ],
      "now": "2026-09-28T13:00:00.000Z"
    },
    {
      "arguments": ["issue", "get", "1"],
      "now": "2026-09-28T13:00:00.000Z"
    }
  ]
}
