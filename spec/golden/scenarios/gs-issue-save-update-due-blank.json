{
  "name": "gs-issue-save-update-due-blank",
  "description": "更新の空の --dueDate が期日を消すことを確かめる",
  "steps": [
    {
      "arguments": ["init"],
      "now": "2026-09-28T12:00:00.000Z"
    },
    {
      "arguments": ["issue", "save", "--title", "x", "--dueDate", "2026-10-01"],
      "now": "2026-09-28T12:00:00.000Z"
    },
    {
      "arguments": ["issue", "save", "--id", "1", "--dueDate", ""],
      "now": "2026-09-28T13:00:00.000Z"
    }
  ]
}
