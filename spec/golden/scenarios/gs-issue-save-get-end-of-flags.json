{
  "name": "gs-issue-save-get-end-of-flags",
  "description": "yaru issue get は -- の後ろの 1 を id として読むことを確かめる",
  "steps": [
    {
      "arguments": ["init"],
      "now": "2026-09-28T12:00:00.000Z"
    },
    {
      "arguments": ["issue", "save", "--title", "hello"],
      "now": "2026-09-28T12:00:00.000Z"
    },
    {
      "arguments": ["issue", "get", "--", "1"],
      "now": "2026-09-28T12:00:00.000Z"
    }
  ]
}
