{
  "name": "gs-issue-save-create-assignee-me-custom-name",
  "description": "--assignee me とイベントの by が、場面で指定した git の user.name になることを確かめる",
  "steps": [
    {
      "arguments": ["init"],
      "now": "2026-09-28T12:00:00.000Z"
    },
    {
      "arguments": ["issue", "save", "--title", "x", "--assignee", "me"],
      "now": "2026-09-28T12:00:00.000Z"
    },
    {
      "arguments": ["issue", "save", "--id", "1", "--title", "y"],
      "now": "2026-09-28T13:00:00.000Z"
    }
  ],
  "setup": {
    "gitUser": {
      "name": "Spec Author",
      "email": "spec@example.com"
    }
  }
}
