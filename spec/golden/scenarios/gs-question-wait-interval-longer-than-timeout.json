{
  "name": "gs-question-wait-interval-longer-than-timeout",
  "description": "question wait の --interval が --timeout より長くても、timeout で戻る。YARU_NOW があっても止まらない",
  "steps": [
    {
      "arguments": ["init"],
      "now": "2026-09-28T00:00:00.000Z"
    },
    {
      "arguments": ["question", "save", "--title", "q", "--answerBy", "1d"],
      "now": "2026-09-28T00:00:00.000Z"
    },
    {
      "arguments": ["question", "wait", "1", "--timeout", "50ms", "--interval", "1h"],
      "now": "2026-09-28T00:00:00.000Z"
    }
  ]
}
