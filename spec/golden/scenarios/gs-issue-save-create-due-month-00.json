{
  "name": "gs-issue-save-create-due-month-00",
  "description": "作成時の dueDate 0 月 (2026-00-01) を YYYY-MM-DD の実在する暦日ではないとして拒み、ファイルを作らないことを確かめる",
  "steps": [
    {
      "arguments": ["init"],
      "now": "2026-09-28T12:00:00.000Z"
    },
    {
      "arguments": ["issue", "save", "--title", "x", "--dueDate", "2026-00-01"],
      "now": "2026-09-28T12:00:00.000Z"
    },
    {
      "arguments": ["issue", "get", "1"],
      "now": "2026-09-28T12:00:00.000Z"
    }
  ]
}
