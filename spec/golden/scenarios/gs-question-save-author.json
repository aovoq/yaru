{
  "name": "gs-question-save-author",
  "description": "質問の author と答えの answeredBy は、そのときの git config user.name",
  "setup": {
    "gitUser": {
      "name": "Spec Author",
      "email": "spec@example.com"
    }
  },
  "steps": [
    {
      "arguments": ["init"],
      "now": "2026-09-28T00:00:00.000Z"
    },
    {
      "arguments": ["question", "save", "--title", "named", "--default", "x", "--answerBy", "1h"],
      "now": "2026-09-28T00:00:00.000Z"
    },
    {
      "arguments": ["question", "answer", "1", "--body", "yes"],
      "now": "2026-09-28T00:01:00.000Z"
    }
  ]
}
