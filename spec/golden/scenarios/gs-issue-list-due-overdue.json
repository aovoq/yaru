{
  "name": "gs-issue-list-due-overdue",
  "description": "yaru issue list の --due overdue が、Asia/Tokyo の今日より前の dueDate だけを残すことを記録する。今日、未来、期日無しは残さない。2026-09-28T12:00:00.000Z の今日は 2026-09-28 である。",
  "steps": [
    {
      "arguments": ["init"],
      "now": "2026-09-28T12:00:00.000Z"
    },
    {
      "arguments": ["issue", "save", "--title", "Past", "--dueDate", "2026-09-27"],
      "now": "2026-09-28T12:01:00.000Z"
    },
    {
      "arguments": ["issue", "save", "--title", "Today", "--dueDate", "2026-09-28"],
      "now": "2026-09-28T12:02:00.000Z"
    },
    {
      "arguments": ["issue", "save", "--title", "Future", "--dueDate", "2026-09-29"],
      "now": "2026-09-28T12:03:00.000Z"
    },
    {
      "arguments": ["issue", "save", "--title", "Undated"],
      "now": "2026-09-28T12:04:00.000Z"
    },
    {
      "arguments": ["issue", "list", "--due", "overdue"],
      "now": "2026-09-28T12:00:00.000Z"
    },
    {
      "arguments": ["issue", "list", "--due", "overdue", "--format"],
      "now": "2026-09-28T12:00:00.000Z"
    }
  ]
}
