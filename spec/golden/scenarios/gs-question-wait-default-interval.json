{
  "name": "gs-question-wait-default-interval",
  "description": "question wait の --interval を省くと 1s だが、--timeout の方が短ければ timeout で戻る",
  "steps": [
    {
      "arguments": ["init"],
      "now": "2026-09-28T00:00:00.000Z"
    },
    {
      "arguments": ["question", "save", "--title", "q"],
      "now": "2026-09-28T00:00:00.000Z"
    },
    {
      "arguments": ["question", "wait", "1", "--timeout", "50ms"],
      "now": "2026-09-28T00:00:00.000Z"
    }
  ]
}
