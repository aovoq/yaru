{
  "name": "gs-issue-save-create-due-year-0001",
  "description": "作成時の dueDate 年 0001 (0001-01-01) を YYYY-MM-DD の実在する暦日ではないとして拒み、ファイルを作らないことを確かめる",
  "steps": [
    {
      "arguments": ["init"],
      "now": "2026-09-28T12:00:00.000Z"
    },
    {
      "arguments": ["issue", "save", "--title", "x", "--dueDate", "0001-01-01"],
      "now": "2026-09-28T12:00:00.000Z"
    },
    {
      "arguments": ["issue", "get", "1"],
      "now": "2026-09-28T12:00:00.000Z"
    }
  ]
}
