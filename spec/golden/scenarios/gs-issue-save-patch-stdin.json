{
  "name": "gs-issue-save-patch-stdin",
  "description": "--patch - が標準入力の JSON 配列を patch として読むことを確かめる",
  "steps": [
    {
      "arguments": ["init"],
      "now": "2026-09-28T12:00:00.000Z"
    },
    {
      "arguments": ["issue", "save", "--title", "x", "--body", "core"],
      "now": "2026-09-28T12:00:00.000Z"
    },
    {
      "arguments": ["issue", "save", "--id", "1", "--patch", "-"],
      "stdin": "[{\"op\":\"append\",\"text\":\"!\"}]",
      "now": "2026-09-28T13:00:00.000Z"
    },
    {
      "arguments": ["issue", "get", "1"],
      "now": "2026-09-28T13:00:00.000Z"
    }
  ]
}
