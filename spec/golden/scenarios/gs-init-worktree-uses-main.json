{
  "name": "gs-init-worktree-uses-main",
  "description": "main を init したあと linked worktree から保存すると、main の .yaru に書き、登録の root も main である",
  "setup": {
    "files": [
      {
        "path": "README.md",
        "content": "latch\n"
      }
    ],
    "commits": [
      {
        "message": "initial",
        "paths": ["README.md"]
      }
    ],
    "worktrees": [
      {
        "name": "feature",
        "branch": "feat/add-thing"
      }
    ]
  },
  "steps": [
    {
      "arguments": ["init"],
      "now": "2026-09-28T12:00:00.000Z"
    },
    {
      "arguments": ["issue", "save", "--title", "From the linked worktree"],
      "workingDirectory": "worktree:feature",
      "now": "2026-09-28T12:05:00.000Z"
    }
  ]
}
