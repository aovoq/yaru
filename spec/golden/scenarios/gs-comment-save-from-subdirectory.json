{
  "name": "gs-comment-save-from-subdirectory",
  "description": "サブディレクトリから保存しても、上にある .yaru にコメントを書く",
  "setup": {
    "files": [
      {
        "path": "src/keep.txt",
        "content": "keep\n"
      }
    ]
  },
  "steps": [
    {
      "arguments": ["init"],
      "now": "2026-09-28T12:00:00.000Z"
    },
    {
      "arguments": ["issue", "save", "--title", "Topic"],
      "now": "2026-09-28T12:00:00.000Z"
    },
    {
      "arguments": ["comment", "save", "--issue", "1", "--body", "from src"],
      "now": "2026-09-28T12:05:00.000Z",
      "workingDirectory": "src"
    }
  ]
}
