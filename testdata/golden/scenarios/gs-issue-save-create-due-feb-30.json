{
  "name": "gs-issue-save-create-due-feb-30",
  "description": "作成時の dueDate 存在しない 2 月 30 日 (2026-02-30) を YYYY-MM-DD の実在する暦日ではないとして拒み、ファイルを作らないことを確かめる",
  "steps": [
    {
      "arguments": ["init"],
      "now": "2026-09-28T12:00:00.000Z"
    },
    {
      "arguments": ["issue", "save", "--title", "x", "--dueDate", "2026-02-30"],
      "now": "2026-09-28T12:00:00.000Z"
    },
    {
      "arguments": ["issue", "get", "1"],
      "now": "2026-09-28T12:00:00.000Z"
    }
  ]
}
