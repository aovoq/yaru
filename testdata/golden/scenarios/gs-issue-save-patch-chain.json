{
  "name": "gs-issue-save-patch-chain",
  "description": "patch の後ろの操作が、前の操作で変わった本文を見ていることを確かめる",
  "steps": [
    {
      "arguments": ["init"],
      "now": "2026-09-28T12:00:00.000Z"
    },
    {
      "arguments": ["issue", "save", "--title", "x", "--body", "core"],
      "now": "2026-09-28T12:00:00.000Z"
    },
    {
      "arguments": [
        "issue",
        "save",
        "--id",
        "1",
        "--patch",
        "[{\"op\":\"prepend\",\"text\":\"HEAD \"},{\"op\":\"replace\",\"old_string\":\"HEAD core\",\"new_string\":\"done\"}]"
      ],
      "now": "2026-09-28T13:00:00.000Z"
    },
    {
      "arguments": ["issue", "get", "1"],
      "now": "2026-09-28T13:00:00.000Z"
    }
  ]
}
