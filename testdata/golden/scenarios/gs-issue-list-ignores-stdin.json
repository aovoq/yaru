{
  "name": "gs-issue-list-ignores-stdin",
  "description": "yaru issue list が標準入力を読まず、渡した文字列を検索語にも本文にもしないことを記録する。",
  "steps": [
    {
      "arguments": ["init"],
      "now": "2026-09-28T12:00:00.000Z"
    },
    {
      "arguments": ["issue", "save", "--title", "Visible"],
      "now": "2026-09-28T12:01:00.000Z"
    },
    {
      "arguments": ["issue", "list"],
      "now": "2026-09-28T12:01:00.000Z",
      "stdin": "not a query\n"
    },
    {
      "arguments": ["issue", "list", "--format"],
      "now": "2026-09-28T12:01:00.000Z",
      "stdin": "hidden\n"
    }
  ]
}
