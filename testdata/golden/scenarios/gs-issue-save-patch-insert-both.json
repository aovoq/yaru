{
  "name": "gs-issue-save-patch-insert-both",
  "description": "insert_before と insert_after を順に適用し、後ろの操作は前の結果を見ていることを確かめる",
  "steps": [
    {
      "arguments": ["init"],
      "now": "2026-09-28T12:00:00.000Z"
    },
    {
      "arguments": ["issue", "save", "--title", "x", "--body", "middle"],
      "now": "2026-09-28T12:00:00.000Z"
    },
    {
      "arguments": [
        "issue",
        "save",
        "--id",
        "1",
        "--patch",
        "[{\"op\":\"insert_before\",\"anchor\":\"middle\",\"text\":\"before\\n\"},{\"op\":\"insert_after\",\"anchor\":\"middle\",\"text\":\"\\nafter\"}]"
      ],
      "now": "2026-09-28T13:00:00.000Z"
    },
    {
      "arguments": ["issue", "get", "1"],
      "now": "2026-09-28T13:00:00.000Z"
    }
  ]
}
