{
  "name": "gs-issue-list-unknown-flag",
  "description": "yaru issue list が知らないフラグを終了コード 1 で拒むことを記録する。save にある --priority、--id、--block、--dueDate や、--sort、1 文字の -x と -F と -p、--status=todo のように = で値を付けた形も知らないフラグである。ワークスペースは開かない。",
  "steps": [
    {
      "arguments": ["issue", "list", "--foo", "bar"],
      "now": "2026-09-28T12:00:00.000Z"
    },
    {
      "arguments": ["issue", "list", "--priority", "high"],
      "now": "2026-09-28T12:00:00.000Z"
    },
    {
      "arguments": ["issue", "list", "--sort", "updated"],
      "now": "2026-09-28T12:00:00.000Z"
    },
    {
      "arguments": ["issue", "list", "--id", "1"],
      "now": "2026-09-28T12:00:00.000Z"
    },
    {
      "arguments": ["issue", "list", "--block", "1"],
      "now": "2026-09-28T12:00:00.000Z"
    },
    {
      "arguments": ["issue", "list", "--dueDate", "2026-09-28"],
      "now": "2026-09-28T12:00:00.000Z"
    },
    {
      "arguments": ["issue", "list", "-x", "bar"],
      "now": "2026-09-28T12:00:00.000Z"
    },
    {
      "arguments": ["issue", "list", "-F", "bar"],
      "now": "2026-09-28T12:00:00.000Z"
    },
    {
      "arguments": ["issue", "list", "-p", "1"],
      "now": "2026-09-28T12:00:00.000Z"
    },
    {
      "arguments": ["issue", "list", "--status=todo", "extra"],
      "now": "2026-09-28T12:00:00.000Z"
    },
    {
      "arguments": ["issue", "list", "--format=table", "extra"],
      "now": "2026-09-28T12:00:00.000Z"
    }
  ]
}
