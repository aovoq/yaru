{
  "name": "gs-init-slug-special",
  "description": "フォルダ名の空白と # は slug でハイフンになり、my project#1 は my-project-1 になる",
  "setup": {
    "files": [
      {
        "path": "my project#1/keep",
        "content": "x\n"
      }
    ]
  },
  "steps": [
    {
      "arguments": ["init"],
      "workingDirectory": "my project#1"
    }
  ]
}
