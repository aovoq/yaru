{
  "name": "gs-comment-save-from-worktree",
  "description": "linked worktree から保存すると元のフォルダの .yaru に入り、同じ場所から一覧できる",
  "setup": {
    "files": [
      {
        "path": "README.md",
        "content": "latch\n"
      }
    ],
    "commits": [
      {
        "message": "initial",
        "paths": ["README.md"]
      }
    ],
    "worktrees": [
      {
        "name": "feature",
        "branch": "feat/add-thing"
      }
    ]
  },
  "steps": [
    {
      "arguments": ["init"],
      "now": "2026-09-28T12:00:00.000Z"
    },
    {
      "arguments": ["issue", "save", "--title", "Topic"],
      "now": "2026-09-28T12:00:00.000Z"
    },
    {
      "arguments": ["comment", "save", "--issue", "1", "--body", "from the worktree"],
      "now": "2026-09-28T12:05:00.000Z",
      "workingDirectory": "worktree:feature"
    },
    {
      "arguments": ["comment", "list", "--issue", "1"],
      "now": "2026-09-28T12:05:00.000Z",
      "workingDirectory": "worktree:feature"
    }
  ]
}
