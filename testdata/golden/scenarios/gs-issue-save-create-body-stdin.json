{
  "name": "gs-issue-save-create-body-stdin",
  "description": "作成時の --body - が標準入力を、改行をエスケープせず本文にすることを確かめる",
  "steps": [
    {
      "arguments": ["init"],
      "now": "2026-09-28T12:00:00.000Z"
    },
    {
      "arguments": ["issue", "save", "--title", "x", "--body", "-"],
      "stdin": "line1\n\nline2",
      "now": "2026-09-28T12:00:00.000Z"
    },
    {
      "arguments": ["issue", "get", "1"],
      "now": "2026-09-28T12:00:00.000Z"
    }
  ]
}
