{
  "name": "gs-comment-save-create-now-offset",
  "description": "オフセット付きの YARU_NOW は、ファイルには UTC の toISOString で書く",
  "steps": [
    {
      "arguments": ["init"],
      "now": "2026-09-28T12:00:00.000Z"
    },
    {
      "arguments": ["issue", "save", "--title", "Topic"],
      "now": "2026-09-28T12:00:00.000Z"
    },
    {
      "arguments": ["comment", "save", "--issue", "1", "--body", "hello"],
      "now": "2026-09-28T21:00:00.000+09:00"
    }
  ]
}
