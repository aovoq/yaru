    },
    {
      "arguments": ["issue", "save", "--title", "blocked"],
      "now": "2026-09-28T12:00:00.000Z"
    },
    {
      "arguments": ["issue", "save", "--id", "2", "--blockedBy", "1", "--blockedBy", "1"],
