{
  "name": "gs-comment-save-create-timezone",
  "description": "タイムゾーンを変えても、 createdAt は UTC の ISO 文字列のままになる",
  "steps": [
    {
      "arguments": ["init"],
      "now": "2026-09-28T12:00:00.000Z"
    },
    {
      "arguments": ["issue", "save", "--title", "Topic"],
      "now": "2026-09-28T12:00:00.000Z"
    },
    {
      "arguments": ["comment", "save", "--issue", "1", "--body", "hello"],
      "now": "2026-09-28T12:05:00.000Z",
      "environment": {
        "TZ": "America/Los_Angeles"
      }
    }
  ]
}
