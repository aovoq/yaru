{
  "name": "gs-issue-list-sort-updated-at",
  "description": "yaru issue list が updatedAt の新しい順に並べ、あとから更新した小さい id が前に出ることを記録する。",
  "steps": [
    {
      "arguments": ["init"],
      "now": "2026-09-28T12:00:00.000Z"
    },
    {
      "arguments": ["issue", "save", "--title", "Older"],
      "now": "2026-09-28T12:01:00.000Z"
    },
    {
      "arguments": ["issue", "save", "--title", "Newer"],
      "now": "2026-09-28T12:02:00.000Z"
    },
    {
      "arguments": ["issue", "save", "--id", "1", "--title", "Older revised"],
      "now": "2026-09-28T12:03:00.000Z"
    },
    {
      "arguments": ["issue", "list"],
      "now": "2026-09-28T12:03:00.000Z"
    },
    {
      "arguments": ["issue", "list", "--format"],
      "now": "2026-09-28T12:03:00.000Z"
    }
  ]
}
