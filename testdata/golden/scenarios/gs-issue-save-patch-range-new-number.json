{
  "name": "gs-issue-save-patch-range-new-number",
  "description": "replace_range の new_string が数値だと拒むことを確かめる",
  "steps": [
    {
      "arguments": ["init"],
      "now": "2026-09-28T12:00:00.000Z"
    },
    {
      "arguments": ["issue", "save", "--title", "x", "--body", "hello WORLD foo"],
      "now": "2026-09-28T12:00:00.000Z"
    },
    {
      "arguments": [
        "issue",
        "save",
        "--id",
        "1",
        "--patch",
        "[{\"op\":\"replace_range\",\"from\":\"hello \",\"to\":\" foo\",\"new_string\":1}]"
      ],
      "now": "2026-09-28T13:00:00.000Z"
    },
    {
      "arguments": ["issue", "get", "1"],
      "now": "2026-09-28T13:00:00.000Z"
    }
  ]
}
