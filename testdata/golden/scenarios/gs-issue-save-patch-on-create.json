{
  "name": "gs-issue-save-patch-on-create",
  "description": "作成時の --patch を、既存 issue の更新でだけ使えるとして拒み、ファイルを作らないことを確かめる",
  "steps": [
    {
      "arguments": ["init"],
      "now": "2026-09-28T12:00:00.000Z"
    },
    {
      "arguments": [
        "issue",
        "save",
        "--title",
        "x",
        "--patch",
        "[{\"op\":\"append\",\"text\":\"!\"}]"
      ],
      "now": "2026-09-28T12:00:00.000Z"
    },
    {
      "arguments": ["issue", "get", "1"],
      "now": "2026-09-28T12:00:00.000Z"
    }
  ]
}
