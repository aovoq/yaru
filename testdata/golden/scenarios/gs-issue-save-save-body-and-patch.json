{
  "name": "gs-issue-save-save-body-and-patch",
  "description": "yaru issue save に --body と --patch を同時に渡すと、適用せずに拒み、本文を変えないことを確かめる",
  "steps": [
    {
      "arguments": ["init"],
      "now": "2026-09-28T12:00:00.000Z"
    },
    {
      "arguments": ["issue", "save", "--title", "x", "--body", "keep"],
      "now": "2026-09-28T12:00:00.000Z"
    },
    {
      "arguments": [
        "issue",
        "save",
        "--id",
        "1",
        "--body",
        "new",
        "--patch",
        "[{\"op\":\"append\",\"text\":\"!\"}]"
      ],
      "now": "2026-09-28T13:00:00.000Z"
    },
    {
      "arguments": ["issue", "get", "1"],
      "now": "2026-09-28T13:00:00.000Z"
    }
  ]
}
