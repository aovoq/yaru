{
  "name": "gs-issue-save-provenance-update-clears-session",
  "description": "セッション変数の無い更新が、前の session を空に戻すことを確かめる。worktree と branch は git から取り直す",
  "steps": [
    {
      "arguments": ["init"],
      "now": "2026-09-28T12:00:00.000Z"
    },
    {
      "arguments": ["issue", "save", "--title", "topic"],
      "environment": {
        "CLAUDE_CODE_SESSION_ID": "session-1"
      },
      "now": "2026-09-28T12:00:00.000Z"
    },
    {
      "arguments": ["issue", "save", "--id", "1", "--title", "renamed"],
      "now": "2026-09-28T13:00:00.000Z"
    },
    {
      "arguments": ["issue", "get", "1"],
      "now": "2026-09-28T13:00:00.000Z"
    }
  ]
}
