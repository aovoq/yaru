{
  "name": "gs-issue-save-clock-save-date-only",
  "description": "yaru issue save は 日付だけ の YARU_NOW を、ファイルを書く前に拒むことを確かめる",
  "steps": [
    {
      "arguments": ["init"],
      "now": "2026-09-28T12:00:00.000Z"
    },
    {
      "arguments": ["issue", "save", "--title", "x"],
      "now": "2026-09-28"
    },
    {
      "arguments": ["issue", "get", "1"],
      "now": "2026-09-28T12:00:00.000Z"
    }
  ]
}
