{
  "name": "gs-comment-save-author-empty-git-name",
  "description": "git の user.name が空なら、 author は me になる",
  "setup": {
    "gitUser": {
      "name": "",
      "email": "golden@example.com"
    }
  },
  "steps": [
    {
      "arguments": ["init"],
      "now": "2026-09-28T12:00:00.000Z"
    },
    {
      "arguments": ["issue", "save", "--title", "Topic"],
      "now": "2026-09-28T12:00:00.000Z"
    },
    {
      "arguments": ["comment", "save", "--issue", "1", "--body", "hello"],
      "now": "2026-09-28T12:05:00.000Z"
    }
  ]
}
