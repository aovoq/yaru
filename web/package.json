{
  "name": "@yaru/web",
  "private": true,
  "type": "module",
  "scripts": {
    "generate": "PATH=\"$PWD/node_modules/.bin:$PATH\" buf generate --template buf.gen.yaml",
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.15.0",
    "@connectrpc/connect": "^2.1.1",
    "@connectrpc/connect-web": "^2.1.1",
    "marked": "^18.0.14",
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@bufbuild/protoc-gen-es": "^2.15.0",
    "@preact/preset-vite": "^2.10.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.5.2",
    "happy-dom": "^20.14.5",
    "preact-render-to-string": "^6.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^7.1.5",
    "vitest": "^3.2.4"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
